<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>自訂手機規格</title>
    <style>
        :root {
            --bg-color: #000000;
            --text-color: #ffffff;
            --theme-color: #4FC3F7; /* 淺藍色 */
            --theme-dim: rgba(79, 195, 247, 0.2);
            --card-bg: #121212;
            --border-color: #333
        }

        * {
            box-sizing: border-box;
            user-select: none; /* 防止選取文字影響體驗 */
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* 左上角標題 */
        .header {
            padding: 20px 30px;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between; /* 讓標題與按鈕分居左右 */
        }

        .header h1 {
            font-size: 1.5rem;
            margin: 0;
            color: var(--theme-color);
            text-shadow: 0 0 10px var(--theme-dim);
            font-weight: 700;
            letter-spacing: 1px;
            border-left: 4px solid var(--theme-color);
            padding-left: 15px;
        }

        /* 重新開始按鈕 (新增) */
        #restart-btn {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--theme-color);
            color: var(--theme-color);
            padding: 8px 20px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.3s;
            display: none; /* 預設隱藏，開始後才顯示 */
            backdrop-filter: blur(5px);
        }

        #restart-btn:hover {
            background: var(--theme-color);
            color: black;
            box-shadow: 0 0 15px var(--theme-dim);
        }

        /* 主內容區域 */
        .main-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            position: relative;
        }

        /* 頁面切換動畫 */
        .page {
            display: none;
            width: 100%;
            text-align: center;
            animation: fadeIn 0.5s ease-out;
        }

        .page.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2 {
            font-size: 2.5rem;
            margin-bottom: 40px;
            font-weight: 300;
        }

        .subtitle {
            color: #888;
            margin-bottom: 20px;
            font-size: 1rem;
        }

        /* 按鈕網格系統 */
        .grid-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .option-btn {
            background: var(--card-bg);
            border: 2px solid var(--border-color);
            color: white;
            padding: 25px 10px;
            font-size: 1.2rem;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .option-btn:hover {
            border-color: var(--theme-color);
            box-shadow: 0 0 15px var(--theme-dim);
        }

        .option-btn.selected {
            background-color: var(--theme-color);
            color: black;
            border-color: var(--theme-color);
            font-weight: bold;
            box-shadow: 0 0 20px var(--theme-color);
        }

        /* 開始按鈕 */
        .start-btn {
            font-size: 2rem;
            padding: 20px 60px;
            background: transparent;
            color: var(--theme-color);
            border: 2px solid var(--theme-color);
            border-radius: 50px;
            cursor: pointer;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .start-btn:hover {
            background: var(--theme-color);
            color: black;
            box-shadow: 0 0 30px var(--theme-color);
        }

        /* 下拉選單 */
        select {
            width: 100%;
            max-width: 500px;
            padding: 15px;
            margin-bottom: 20px;
            background-color: var(--card-bg);
            color: white;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 1.1rem;
            outline: none;
        }

        select:focus {
            border-color: var(--theme-color);
        }

        /* 拉桿樣式 Range Slider */
        .slider-wrapper {
            margin: 40px 0;
            padding: 20px;
            background: var(--card-bg);
            border-radius: 15px;
            border: 1px solid var(--border-color);
        }

        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            height: 6px;
            background: #333;
            border-radius: 5px;
            outline: none;
            margin: 20px 0;
        }

        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--theme-color);
            cursor: pointer;
            box-shadow: 0 0 10px var(--theme-color);
            transition: transform 0.2s;
        }

        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
        }

        .slider-value {
            font-size: 3rem;
            font-weight: bold;
            color: var(--theme-color);
            margin-top: 10px;
        }

        .slider-unit {
            font-size: 1.2rem;
            color: #aaa;
        }

        /* 導航按鈕 */
        .nav-buttons {
            display: flex;
            justify-content: space-between;
            width: 100%;
            margin-top: auto;
            padding-top: 20px;
        }

        .nav-btn {
            background: transparent;
            border: none;
            color: #666;
            font-size: 1rem;
            cursor: pointer;
            padding: 10px 20px;
            border-radius: 5px;
            transition: 0.3s;
        }

        .nav-btn:hover {
            color: white;
        }

        .nav-btn.next {
            background-color: var(--theme-color);
            color: black;
            font-weight: bold;
        }
        
        .nav-btn.next:hover {
            box-shadow: 0 0 15px var(--theme-dim);
            opacity: 0.9;
        }

        .nav-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            background: #333;
            color: #555;
            box-shadow: none;
        }

        /* 總覽頁面 */
        .summary-card {
            background: var(--card-bg);
            border-radius: 15px;
            padding: 30px;
            text-align: left;
            max-height: 60vh;
            overflow-y: auto;
            border: 1px solid var(--border-color);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #333;
        }

        .summary-row:last-child {
            border-bottom: none;
        }

        .s-label { color: #888; }
        .s-value { color: white; font-weight: bold; text-align: right;}

        .price-section {
            margin-top: 30px;
            text-align: center;
            border-top: 2px dashed var(--theme-color);
            padding-top: 20px;
        }

        .final-price {
            font-size: 3.5rem;
            color: var(--theme-color);
            font-weight: 800;
            text-shadow: 0 0 20px var(--theme-dim);
        }
        
        .price-note {
            font-size: 0.9rem;
            color: #666;
            margin-top: 10px;
        }

        /* RWD */
        @media (max-width: 600px) {
            h2 { font-size: 1.8rem; }
            .grid-options { grid-template-columns: repeat(2, 1fr); }
            .slider-value { font-size: 2rem; }
            .header { padding: 15px 20px; }
            #restart-btn { padding: 6px 12px; font-size: 0.8rem; }
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>自訂手機規格</h1>
        <!-- 新增重新開始按鈕 -->
        <button id="restart-btn" onclick="location.reload()">↺ 重新開始</button>
    </div>

    <div class="main-container">
        <!-- 頁面 1: 首頁 -->
        <div class="page active" id="page-1">
            <div style="margin-bottom: 50px;">
                <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#4FC3F7" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
            </div>
            <h2>打造您的專屬旗艦</h2>
            <p class="subtitle">12 個步驟，完全客製化，即時估價</p>
            <button class="start-btn" onclick="nextPage()">開始訂製</button>
        </div>

        <!-- 頁面 2: 記憶體 -->
        <div class="page" id="page-2">
            <h2>選擇記憶體 (RAM)</h2>
            <div class="grid-options" id="ram-options">
                <!-- JS 產生 -->
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="nextPage()">下一步</button>
            </div>
        </div>

        <!-- 頁面 3: 儲存空間 -->
        <div class="page" id="page-3">
            <h2>選擇儲存空間 (ROM)</h2>
            <div class="grid-options" id="rom-options">
                <!-- JS 產生 -->
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="nextPage()">下一步</button>
            </div>
        </div>

        <!-- 頁面 4: 處理器 -->
        <div class="page" id="page-4">
            <h2>核心處理器</h2>
            <p class="subtitle">決定手機效能的關鍵心臟</p>
            
            <div style="text-align: left;">
                <label style="color:var(--theme-color); margin-bottom:5px; display:block;">1. 晶片廠商</label>
                <select id="cpu-brand" onchange="updateCpuModels()">
                    <option value="">請選擇廠商...</option>
                    <option value="Snapdragon">Snapdragon (高通)</option>
                    <option value="MediaTek">MediaTek (聯發科)</option>
                    <option value="Apple">Apple (蘋果)</option>
                    <option value="Other">其它 (Google/Samsung)</option>
                </select>

                <label style="color:var(--theme-color); margin-bottom:5px; display:block;">2. 晶片型號 (2022-2026)</label>
                <select id="cpu-model" disabled>
                    <option value="">請先選擇廠商</option>
                </select>
            </div>

            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" id="cpu-next-btn" onclick="nextPage()" disabled>下一步</button>
            </div>
        </div>

        <!-- 頁面 5: 螢幕亮度 -->
        <div class="page" id="page-5">
            <h2>螢幕峰值亮度</h2>
            <div class="slider-wrapper">
                <input type="range" min="500" max="6000" step="100" value="2000" id="brightness-slider" oninput="updateSliderDisplay(this, 'brightness-val', ' nits')">
                <div class="slider-value"><span id="brightness-val">2000</span><span class="slider-unit"> nits</span></div>
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="nextPage()">下一步</button>
            </div>
        </div>

        <!-- 頁面 6: 螢幕解析度 -->
        <div class="page" id="page-6">
            <h2>螢幕解析度</h2>
            <div class="slider-wrapper">
                <input type="range" min="1" max="5" step="1" value="2" id="resolution-slider" oninput="updateResolutionDisplay(this)">
                <div class="slider-value" id="resolution-text">FHD+</div>
                <div class="slider-unit" id="resolution-subtext">標準 1080p</div>
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="nextPage()">下一步</button>
            </div>
        </div>

        <!-- 頁面 7: 螢幕材質 -->
        <div class="page" id="page-7">
            <h2>螢幕材質</h2>
            <div class="grid-options" style="grid-template-columns: 1fr 1fr;">
                <button class="option-btn" onclick="selectSingleOption(this, 'screen_type', 'LCD')">LCD<br><span style="font-size:0.8rem; color:#888;">護眼、成本低</span></button>
                <button class="option-btn selected" onclick="selectSingleOption(this, 'screen_type', 'AMOLED')">AMOLED<br><span style="font-size:0.8rem; color:#888;">鮮豔、省電、黑色純淨</span></button>
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="nextPage()">下一步</button>
            </div>
        </div>

        <!-- 頁面 8: 電池容量 -->
        <div class="page" id="page-8">
            <h2>電池容量</h2>
            <div class="slider-wrapper">
                <input type="range" min="3000" max="10000" step="100" value="5000" id="battery-slider" oninput="updateSliderDisplay(this, 'battery-val', '')">
                <div class="slider-value"><span id="battery-val">5000</span><span class="slider-unit"> mAh</span></div>
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="nextPage()">下一步</button>
            </div>
        </div>

        <!-- 頁面 9: 有線充電 -->
        <div class="page" id="page-9">
            <h2>有線快充速度</h2>
            <div class="slider-wrapper">
                <input type="range" min="20" max="240" step="10" value="67" id="wired-slider" oninput="updateSliderDisplay(this, 'wired-val', '')">
                <div class="slider-value"><span id="wired-val">67</span><span class="slider-unit"> W</span></div>
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="nextPage()">下一步</button>
            </div>
        </div>

        <!-- 頁面 10: 無線充電 -->
        <div class="page" id="page-10">
            <h2>無線充電速度</h2>
            <div class="slider-wrapper">
                <input type="range" min="0" max="100" step="5" value="0" id="wireless-slider" oninput="updateSliderDisplay(this, 'wireless-val', '')">
                <div class="slider-value"><span id="wireless-val">0</span><span class="slider-unit"> W</span></div>
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="nextPage()">下一步</button>
            </div>
        </div>

        <!-- 頁面 11: 相機規格 -->
        <div class="page" id="page-11">
            <h2>後置相機組合 (可複選)</h2>
            <div class="grid-options" id="camera-options">
                <button class="option-btn selected" onclick="toggleMultiOption(this, 'Main')">廣角主鏡頭<br>(Wide)</button>
                <button class="option-btn" onclick="toggleMultiOption(this, 'UltraWide')">超廣角<br>(Ultra Wide)</button>
                <button class="option-btn" onclick="toggleMultiOption(this, 'Telephoto')">長焦鏡頭<br>(Telephoto)</button>
            </div>
            <div class="nav-buttons">
                <button class="nav-btn" onclick="prevPage()">上一步</button>
                <button class="nav-btn next" onclick="finishAndCalculate()">查看估價</button>
            </div>
        </div>

        <!-- 頁面 12: 總覽 -->
        <div class="page" id="page-12">
            <h2>規格總覽 & 價格評估</h2>
            <div class="summary-card" id="summary-content">
                <!-- JS 動態生成 -->
            </div>
            <div class="price-section">
                <div style="color:#888;">預估售價 (新台幣)</div>
                <div class="final-price" id="final-price-display">NT$ 0</div>
                <div class="price-note">*價格基於 POCO 高性價比策略演算法估算</div>
            </div>
            <div class="nav-buttons" style="margin-top: 30px;">
                <button class="nav-btn" onclick="location.reload()">重新設計</button>
            </div>
        </div>

    </div>

    <script>
        // 資料庫：處理器 (包含 2022-2026, 部分為預測型號)
        // priceScore: 基礎成本分數 (1-100)
        const processors = {
            "Snapdragon": [
                { name: "Snapdragon 8 Elite Gen 5 (2026)", priceScore: 110 },
                { name: "Snapdragon 8 Elite (2024)", priceScore: 100 },
                { name: "Snapdragon 8s Gen 3 (2024)", priceScore: 65 }, // POCO F6 等級
                { name: "Snapdragon 8 Gen 3 (2024)", priceScore: 85 },
                { name: "Snapdragon 7+ Gen 3 (2024)", priceScore: 55 },
                { name: "Snapdragon 8 Gen 2 (2023)", priceScore: 60 },
                { name: "Snapdragon 7+ Gen 2 (2023)", priceScore: 45 }, // POCO F5 等級
                { name: "Snapdragon 8+ Gen 1 (2022)", priceScore: 40 },
                { name: "Snapdragon 7 Gen 3 (2024)", priceScore: 35 },
                { name: "Snapdragon 6 Gen 1 (2022)", priceScore: 20 }
            ],
            "MediaTek": [
                { name: "Dimensity 9500 (2026)", priceScore: 95 },
                { name: "Dimensity 9400 (2024)", priceScore: 85 },
                { name: "Dimensity 9300+ (2024)", priceScore: 80 },
                { name: "Dimensity 9200 (2023)", priceScore: 55 },
                { name: "Dimensity 8300-Ultra (2024)", priceScore: 45 }, // POCO X6 Pro 等級
                { name: "Dimensity 8200 (2023)", priceScore: 35 },
                { name: "Dimensity 7200 (2023)", priceScore: 30 },
                { name: "Dimensity 1080 (2022)", priceScore: 20 }
            ],
            "Apple": [
                { name: "A19 Pro (2025)", priceScore: 110 },
                { name: "A18 Pro (2024)", priceScore: 100 },
                { name: "A18 (2024)", priceScore: 85 },
                { name: "A17 Pro (2023)", priceScore: 80 },
                { name: "A16 Bionic (2022)", priceScore: 60 }
            ],
            "Other": [
                { name: "Google Tensor G5 (2025)", priceScore: 70 },
                { name: "Google Tensor G4 (2024)", priceScore: 60 },
                { name: "Exynos 2400 (2024)", priceScore: 55 },
                { name: "Exynos 2200 (2022)", priceScore: 30 }
            ]
        };

        // 狀態變數
        let currentStep = 1;
        const totalSteps = 12;
        let userSelection = {
            ram: 12,
            rom: 256,
            cpuBrand: "",
            cpuModel: "",
            cpuScore: 0,
            brightness: 2000,
            resolution: 2, // 索引
            resolutionName: "FHD+",
            screenType: "AMOLED",
            battery: 5000,
            wiredCharge: 67,
            wirelessCharge: 0,
            cameras: ["Main"]
        };

        // 初始化
        window.onload = function() {
            generateButtons('ram-options', [4, 6, 8, 12, 16, 24], 'GB', 'ram');
            generateButtons('rom-options', [128, 256, 512, 1024], (v) => v===1024?'1TB':'GB', 'rom');
        };

        // 生成選項按鈕
        function generateButtons(containerId, values, unit, key) {
            const container = document.getElementById(containerId);
            values.forEach(val => {
                const btn = document.createElement('button');
                btn.className = `option-btn ${userSelection[key] === val ? 'selected' : ''}`;
                const unitText = typeof unit === 'function' ? unit(val) : unit;
                const displayVal = val === 1024 ? '1' : val;
                btn.innerHTML = `${displayVal}<br><small>${unitText}</small>`;
                btn.onclick = () => {
                    // 移除其他選取狀態
                    container.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
                    btn.classList.add('selected');
                    userSelection[key] = val;
                };
                container.appendChild(btn);
            });
        }

        // 頁面導航
        function nextPage() {
            if (currentStep < totalSteps) {
                document.getElementById(`page-${currentStep}`).classList.remove('active');
                currentStep++;
                document.getElementById(`page-${currentStep}`).classList.add('active');
            }
            // 控制重新開始按鈕顯示
            document.getElementById('restart-btn').style.display = currentStep > 1 ? 'block' : 'none';
        }

        function prevPage() {
            if (currentStep > 1) {
                document.getElementById(`page-${currentStep}`).classList.remove('active');
                currentStep--;
                document.getElementById(`page-${currentStep}`).classList.add('active');
            }
            // 控制重新開始按鈕顯示
            document.getElementById('restart-btn').style.display = currentStep > 1 ? 'block' : 'none';
        }

        // 處理器邏輯
        function updateCpuModels() {
            const brandSelect = document.getElementById('cpu-brand');
            const modelSelect = document.getElementById('cpu-model');
            const nextBtn = document.getElementById('cpu-next-btn');
            
            const brand = brandSelect.value;
            modelSelect.innerHTML = '<option value="">請選擇型號...</option>';
            
            if (brand && processors[brand]) {
                modelSelect.disabled = false;
                processors[brand].forEach((cpu, index) => {
                    const opt = document.createElement('option');
                    opt.value = index; // 存索引以獲取完整物件
                    opt.textContent = cpu.name;
                    modelSelect.appendChild(opt);
                });
            } else {
                modelSelect.disabled = true;
            }

            // 監聽型號變更
            modelSelect.onchange = () => {
                if (modelSelect.value !== "") {
                    userSelection.cpuBrand = brand;
                    const selectedCpu = processors[brand][modelSelect.value];
                    userSelection.cpuModel = selectedCpu.name;
                    userSelection.cpuScore = selectedCpu.priceScore;
                    nextBtn.disabled = false;
                } else {
                    nextBtn.disabled = true;
                }
            };
        }

        // 滑桿顯示更新
        function updateSliderDisplay(el, displayId, unit) {
            document.getElementById(displayId).innerText = el.value;
            // 更新狀態
            if(el.id === 'brightness-slider') userSelection.brightness = parseInt(el.value);
            if(el.id === 'battery-slider') userSelection.battery = parseInt(el.value);
            if(el.id === 'wired-slider') userSelection.wiredCharge = parseInt(el.value);
            if(el.id === 'wireless-slider') userSelection.wirelessCharge = parseInt(el.value);
        }

        // 解析度滑桿特殊處理
        function updateResolutionDisplay(el) {
            const resolutions = [
                { val: 1, name: "HD+", desc: "720p 入門" },
                { val: 2, name: "FHD+", desc: "1080p 標準" },
                { val: 3, name: "1.5K", desc: "1220p 清晰" },
                { val: 4, name: "2K QHD+", desc: "1440p 細膩" },
                { val: 5, name: "4K", desc: "2160p 極致" }
            ];
            const current = resolutions[el.value - 1];
            document.getElementById('resolution-text').innerText = current.name;
            document.getElementById('resolution-subtext').innerText = current.desc;
            
            userSelection.resolution = parseInt(el.value);
            userSelection.resolutionName = current.name;
        }

        // 單選按鈕處理 (螢幕材質)
        function selectSingleOption(btn, key, value) {
            const parent = btn.parentNode;
            parent.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            if (key === 'screen_type') userSelection.screenType = value;
        }

        // 複選按鈕處理 (相機)
        function toggleMultiOption(btn, value) {
            btn.classList.toggle('selected');
            const index = userSelection.cameras.indexOf(value);
            if (btn.classList.contains('selected')) {
                if (index === -1) userSelection.cameras.push(value);
            } else {
                if (index > -1) userSelection.cameras.splice(index, 1);
            }
        }

        // 計算價格與顯示總覽
        function finishAndCalculate() {
            // 切換頁面
            nextPage();

            // 1. 顯示總覽
            const summaryDiv = document.getElementById('summary-content');
            let cameraText = userSelection.cameras.length > 0 ? 
                userSelection.cameras.map(c => {
                    if(c==='Main') return '廣角';
                    if(c==='UltraWide') return '超廣角';
                    if(c==='Telephoto') return '長焦';
                }).join(' + ') : '無相機 (純電競?)';

            let romText = userSelection.rom === 1024 ? '1TB' : userSelection.rom + ' GB';

            summaryDiv.innerHTML = `
                <div class="summary-row"><span class="s-label">處理器</span><span class="s-value">${userSelection.cpuBrand}<br><small>${userSelection.cpuModel}</small></span></div>
                <div class="summary-row"><span class="s-label">記憶體 (RAM)</span><span class="s-value">${userSelection.ram} GB</span></div>
                <div class="summary-row"><span class="s-label">儲存空間 (ROM)</span><span class="s-value">${romText}</span></div>
                <div class="summary-row"><span class="s-label">螢幕</span><span class="s-value">${userSelection.screenType} / ${userSelection.resolutionName}<br>${userSelection.brightness} nits</span></div>
                <div class="summary-row"><span class="s-label">電池與充電</span><span class="s-value">${userSelection.battery} mAh<br>${userSelection.wiredCharge}W 有線 / ${userSelection.wirelessCharge}W 無線</span></div>
                <div class="summary-row"><span class="s-label">相機</span><span class="s-value">${cameraText}</span></div>
            `;

            // 2. 價格演算法 (基於 POCO / 高 CP 值邏輯)
            let basePrice = 3000; // 基礎組裝、外殼、物流、稅金

            // CPU: 分數 * 加權 (高階晶片非常貴)
            // SD 8 Gen 3 成本約 $200 USD (6000 TWD)，這裡做模擬
            let cpuCost = userSelection.cpuScore * 120; 

            // RAM: 1GB 約 150元 (DDR5X)
            let ramCost = userSelection.ram * 120;

            // ROM: 1GB 約 8元 (UFS 4.0)
            let romCost = userSelection.rom * 8;

            // Screen
            let screenCost = 1000; // 基礎
            if (userSelection.screenType === 'AMOLED') screenCost += 1500;
            screenCost += (userSelection.resolution - 1) * 800; // 解析度加價
            screenCost += (userSelection.brightness - 500) * 0.5; // 亮度加價

            // Battery & Charging
            let batteryCost = (userSelection.battery - 3000) * 0.2;
            let chargeCost = userSelection.wiredCharge * 5; // 高瓦數需要更好的晶片與散熱
            chargeCost += userSelection.wirelessCharge * 10; // 無線充電線圈成本

            // Camera
            let camCost = 0;
            if (userSelection.cameras.includes('Main')) camCost += 1500; // 基礎不錯的主攝
            if (userSelection.cameras.includes('UltraWide')) camCost += 800;
            if (userSelection.cameras.includes('Telephoto')) camCost += 2500; // 長焦最貴

            // 總價計算
            let rawTotal = basePrice + cpuCost + ramCost + romCost + screenCost + batteryCost + chargeCost + camCost;

            // POCO 修正係數 (大量採購壓低成本，稍微打折)
            // UPDATE: 用戶要求再打 8 折 (0.9 * 0.8 * 0.8 = 0.576) 超級骨折價
            let finalPrice = Math.round(rawTotal * 0.9 * 0.8 * 0.8 / 100) * 100; // 取整百
            
            // 修正極端值 (避免低於市場下限或過高)
            // 因應連續打折，大幅調低最低價保護線
            if (userSelection.cpuScore > 80 && finalPrice < 8000) finalPrice = 8990; // 旗艦芯最低價
            if (finalPrice < 2000) finalPrice = 1990;

            // 動畫顯示價格
            animateValue("final-price-display", 0, finalPrice, 1500);
        }

        function animateValue(id, start, end, duration) {
            let obj = document.getElementById(id);
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                const currentVal = Math.floor(progress * (end - start) + start);
                obj.innerHTML = "NT$ " + currentVal.toLocaleString();
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }

    </script>
</body>
